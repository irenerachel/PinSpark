{
  "manifest_version": 3,
  "name": "PinSpark - 视觉灵感关键词",
  "version": "1.0.4",
  "description": "快速生成 Pinterest & Behance & 花瓣网 高质量视觉搜索关键词，支持豆包 / DeepSeek / Kimi 三家 API，点击即复制",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://ark.cn-beijing.volces.com/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PinSpark"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
