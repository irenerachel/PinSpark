{
  "manifest_version": 3,
  "name": "PinSpark - 视觉灵感关键词",
  "version": "1.0.0",
  "description": "快速生成 Pinterest & Behance 高质量视觉搜索关键词（豆包 / DeepSeek 版），点击即复制",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PinSpark"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
